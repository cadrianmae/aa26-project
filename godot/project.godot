; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Matriarch Command"
config/description="CMPU 4031 Autonomous Agents artifact. Mae Capacite C21348423."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

; A fixed 1280x720 logical canvas, stretched to whatever window the player
; has. PixelView then shrinks that by 2 to render at exactly 640x360 on every
; machine -- without this the render resolution would follow the window size,
; so the pixels would be a different size on every display and the effect
; would be a different one on a laptop than on a monitor.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; "expand" rather than "keep": keep letterboxes to exactly 16:9, leaving bars
; on any other window shape. Expand grows the canvas to fill the window
; instead, so a wider window shows MORE of the belt at the same pixel size --
; which is what preserves square pixels. Stretching the aspect would make
; pixels non-square, and that is the one thing pixel art cannot survive.
window/stretch/aspect="expand"

[shader_globals]

; Written at run time by StarSystem, which drives the sky shader, the
; DirectionalLight3D and every hull from one source. Declared here rather than
; registered in code so they exist before any shader compiles -- a global that
; a shader reads before it is registered comes back as zero, which renders
; every hull black.
sun_direction={
"type": "vec3",
"value": Vector3(0.4, 0.35, 0.85)
}
sun_colour={
"type": "color",
"value": Color(1, 0.957, 0.91, 1)
}
fill_colour={
"type": "color",
"value": Color(0.16, 0.14, 0.11, 1)
}

[autoload]

GizmoToggle="*res://scripts/control/gizmo_toggle.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

